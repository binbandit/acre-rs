{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acre.dev/schemas/acre-repo.schema.json",
  "title": "Acre repository environment policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cacheRoots": { "$ref": "#/$defs/paths" },
        "requiredRoots": { "$ref": "#/$defs/paths" },
        "seedFiles": { "$ref": "#/$defs/paths" },
        "excludedRoots": { "$ref": "#/$defs/paths" }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": { "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$))" }
      },
      "uniqueItems": true
    }
  }
}
